+package com.zipbug.base.creator
+
+import android.content.Context
+import com.zipbug.base.data.ProjectRepository
+import com.zipbug.base.data.model.ProjectInfo
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+import java.io.File
+
+object ProjectGenerator {
+
+    suspend fun generateFromSpec(
+        context: Context,
+        spec: GeneratedProjectSpec
+    ): Result<ProjectInfo> = withContext(Dispatchers.IO) {
+        runCatching {
+            val safeSlug = spec.name.lowercase().replace(Regex("[^a-z0-9_]"), "_")
+            val targetDir = File(File(context.filesDir, "projects"), safeSlug)
+
+            if (!targetDir.exists()) {
+                targetDir.mkdirs()
+            }
+
+            // Write all files
+            for (file in spec.files) {
+                val outFile = File(targetDir, file.path)
+                outFile.parentFile?.mkdirs()
+                outFile.writeText(file.content, Charsets.UTF_8)
+            }
+
+            // Write app.json manifest
+            val manifest = JSONObject().apply {
+                put("name", spec.name)
+                put("slug", safeSlug)
+                put("version", "1.0.0")
+                put("kind", if (spec.target.contains("WEB")) "web-mini-app" else "android")
+                put("packageName", spec.packageName)
+                put("minSdk", spec.minSdk)
+                put("targetSdk", spec.targetSdk)
+                put("target", spec.target)
+                put("buildCommand", spec.buildCommand)
+            }
+            File(targetDir, "app.json").writeText(manifest.toString(2), Charsets.UTF_8)
+
+            ProjectInfo(
+                name = spec.name,
+                path = targetDir.absolutePath,
+                lastModified = System.currentTimeMillis(),
+                kind = if (spec.target.contains("WEB")) "web-mini-app" else "android"
+            )
+        }
+    }
+}
