@@ -0,0 +1,187 @@
+package com.zipbug.base.ui.ai
+
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.content.Context
+import android.os.Bundle
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.AdapterView
+import android.widget.ArrayAdapter
+import android.widget.EditText
+import android.widget.ProgressBar
+import android.widget.Spinner
+import android.widget.TextView
+import androidx.core.view.isVisible
+import androidx.fragment.app.Fragment
+import androidx.lifecycle.lifecycleScope
+import com.google.android.material.button.MaterialButton
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.google.android.material.snackbar.Snackbar
+import com.zipbug.base.R
+import com.zipbug.base.ai.AiKeyStore
+import com.zipbug.base.ai.AiMode
+import com.zipbug.base.ai.AiProvider
+import com.zipbug.base.ai.AiService
+import com.zipbug.base.ai.ProviderStatus
+import com.zipbug.base.creator.AppCreatorParser
+import com.zipbug.base.creator.GeneratedProjectSpec
+import com.zipbug.base.creator.ProjectGenerator
+import kotlinx.coroutines.launch
+
+class AiFragment : Fragment() {
+
+    private lateinit var aiService: AiService
+    private var currentSpec: GeneratedProjectSpec? = null
+
+    override fun onCreateView(inflater: LayoutInflater, container: ViewGroup?, state: Bundle?): View {
+        return inflater.inflate(R.layout.fragment_ai, container, false)
+    }
+
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+        val context = requireContext()
+        aiService = AiService(context)
+
+        val providerSpinner = view.findViewById<Spinner>(R.id.providerSpinner)
+        val modeSpinner = view.findViewById<Spinner>(R.id.modeSpinner)
+        val modelEditText = view.findViewById<EditText>(R.id.modelEditText)
+        val promptEditText = view.findViewById<EditText>(R.id.promptEditText)
+        val apiKeyStatusText = view.findViewById<TextView>(R.id.apiKeyStatusText)
+        val setKeyButton = view.findViewById<MaterialButton>(R.id.setKeyButton)
+        val generateButton = view.findViewById<MaterialButton>(R.id.generateButton)
+        val progressBar = view.findViewById<ProgressBar>(R.id.progressBar)
+        val copyButton = view.findViewById<MaterialButton>(R.id.copyButton)
+        val applyCreatorButton = view.findViewById<MaterialButton>(R.id.applyCreatorButton)
+        val resultTextView = view.findViewById<TextView>(R.id.resultTextView)
+
+        // Setup Providers
+        val providers = AiProvider.values()
+        val providerAdapter = ArrayAdapter(context, android.R.layout.simple_spinner_dropdown_item, providers.map { it.displayName })
+        providerSpinner.adapter = providerAdapter
+
+        // Setup Modes
+        val modes = AiMode.values()
+        val modeAdapter = ArrayAdapter(context, android.R.layout.simple_spinner_dropdown_item, modes.map { it.title })
+        modeSpinner.adapter = modeAdapter
+
+        fun updateKeyStatus(provider: AiProvider) {
+            val hasKey = AiKeyStore.hasKey(context, provider)
+            apiKeyStatusText.text = if (hasKey) "API Key: Configured (Encrypted)" else "API Key: Not configured"
+            modelEditText.setText(provider.defaultModel)
+        }
+
+        providerSpinner.onItemSelectedListener = object : AdapterView.OnItemSelectedListener {
+            override fun onItemSelected(parent: AdapterView<*>?, view: View?, position: Int, id: Long) {
+                updateKeyStatus(providers[position])
+            }
+            override fun onNothingSelected(parent: AdapterView<*>?) {}
+        }
+
+        modeSpinner.onItemSelectedListener = object : AdapterView.OnItemSelectedListener {
+            override fun onItemSelected(parent: AdapterView<*>?, view: View?, position: Int, id: Long) {
+                val mode = modes[position]
+                if (mode == AiMode.APP_CREATOR) {
+                    promptEditText.hint = "e.g., Create a note taking app with Room database and dark mode"
+                } else if (mode == AiMode.TTS_SCRIPT) {
+                    promptEditText.hint = "e.g., Write a 30-second Burmese educational voiceover script"
+                } else {
+                    promptEditText.hint = "Describe the task..."
+                }
+            }
+            override fun onNothingSelected(parent: AdapterView<*>?) {}
+        }
+
+        setKeyButton.setOnClickListener {
+            val selectedProvider = providers[providerSpinner.selectedItemPosition]
+            val input = EditText(context).apply {
+                hint = "Enter ${selectedProvider.displayName} API Key (${selectedProvider.keyPrefix}...)"
+                setPadding(32, 32, 32, 32)
+            }
+            MaterialAlertDialogBuilder(context)
+                .setTitle("Configure ${selectedProvider.displayName} Key")
+                .setMessage("Key will be encrypted in Android Keystore with AES-GCM.")
+                .setView(input)
+                .setPositiveButton("Save") { _, _ ->
+                    val key = input.text.toString().trim()
+                    if (key.isNotEmpty()) {
+                        AiKeyStore.saveKey(context, selectedProvider, key)
+                        updateKeyStatus(selectedProvider)
+                        Snackbar.make(view, "Key encrypted and saved successfully", Snackbar.LENGTH_SHORT).show()
+                    }
+                }
+                .setNegativeButton("Cancel", null)
+                .show()
+        }
+
+        generateButton.setOnClickListener {
+            val selectedProvider = providers[providerSpinner.selectedItemPosition]
+            val selectedMode = modes[modeSpinner.selectedItemPosition]
+            val prompt = promptEditText.text.toString().trim()
+            val model = modelEditText.text.toString().trim()
+
+            if (prompt.isEmpty()) {
+                Snackbar.make(view, "Please enter a prompt", Snackbar.LENGTH_SHORT).show()
+                return@setOnClickListener
+            }
+
+            progressBar.isVisible = true
+            generateButton.isEnabled = false
+            applyCreatorButton.isVisible = false
+            currentSpec = null
+
+            viewLifecycleOwner.lifecycleScope.launch {
+                val response = aiService.sendRequest(
+                    provider = selectedProvider,
+                    mode = selectedMode,
+                    userPrompt = prompt,
+                    modelOverride = model.ifBlank { null }
+                )
+
+                progressBar.isVisible = false
+                generateButton.isEnabled = true
+
+                if (response.success) {
+                    resultTextView.text = response.content
+                    if (selectedMode == AiMode.APP_CREATOR) {
+                        val parsed = AppCreatorParser.parse(response.content)
+                        parsed.onSuccess { spec ->
+                            currentSpec = spec
+                            applyCreatorButton.isVisible = true
+                            Snackbar.make(view, "Structured app spec parsed! Ready to create project.", Snackbar.LENGTH_LONG).show()
+                        }.onFailure {
+                            applyCreatorButton.isVisible = false
+                        }
+                    }
+                } else {
+                    resultTextView.text = "Error: [${response.status}] ${response.errorMessage}"
+                    Snackbar.make(view, response.errorMessage ?: "AI Request Failed", Snackbar.LENGTH_LONG).show()
+                }
+            }
+        }
+
+        copyButton.setOnClickListener {
+            val text = resultTextView.text.toString()
+            val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+            clipboard.setPrimaryClip(ClipData.newPlainText("AI Output", text))
+            Snackbar.make(view, "Copied to clipboard", Snackbar.LENGTH_SHORT).show()
+        }
+
+        applyCreatorButton.setOnClickListener {
+            val spec = currentSpec ?: return@setOnClickListener
+            viewLifecycleOwner.lifecycleScope.launch {
+                val result = ProjectGenerator.generateFromSpec(context, spec)
+                result.onSuccess { proj ->
+                    MaterialAlertDialogBuilder(context)
+                        .setTitle("Project Created!")
+                        .setMessage("Created project '${proj.name}' at:\n${proj.path}\n\nBuild command: ${spec.buildCommand}")
+                        .setPositiveButton("OK", null)
+                        .show()
+                }.onFailure { err ->
+                    Snackbar.make(view, "Creation failed: ${err.message}", Snackbar.LENGTH_LONG).show()
+                }
+            }
+        }
+    }
+}
