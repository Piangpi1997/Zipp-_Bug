+package com.zipbug.base.ai
+
+import android.content.Context
+import com.zipbug.base.security.KeystoreManager
+
+object AiKeyStore {
+    private const val PREFS_AI_KEYS = "zipbug_ai_keys_vault"
+
+    fun saveKey(context: Context, provider: AiProvider, rawKey: String) {
+        val encrypted = KeystoreManager.encrypt(rawKey.trim())
+        context.getSharedPreferences(PREFS_AI_KEYS, Context.MODE_PRIVATE)
+            .edit()
+            .putString("key_${provider.name}", encrypted)
+            .apply()
+    }
+
+    fun getKey(context: Context, provider: AiProvider): String {
+        val encrypted = context.getSharedPreferences(PREFS_AI_KEYS, Context.MODE_PRIVATE)
+            .getString("key_${provider.name}", null) ?: return ""
+        return runCatching { KeystoreManager.decrypt(encrypted) }.getOrDefault("")
+    }
+
+    fun hasKey(context: Context, provider: AiProvider): Boolean {
+        return getKey(context, provider).isNotBlank()
+    }
+
+    fun validateKeyFormat(provider: AiProvider, rawKey: String): Boolean {
+        val trimmed = rawKey.trim()
+        if (trimmed.isEmpty()) return false
+        return when (provider) {
+            AiProvider.OPENROUTER -> trimmed.startsWith("sk-or-")
+            AiProvider.OPENAI -> trimmed.startsWith("sk-") && !trimmed.startsWith("sk-or-") && !trimmed.startsWith("sk-ant-")
+            AiProvider.CLAUDE -> trimmed.startsWith("sk-ant-")
+            AiProvider.GEMINI -> trimmed.length >= 20
+        }
+    }
+}
