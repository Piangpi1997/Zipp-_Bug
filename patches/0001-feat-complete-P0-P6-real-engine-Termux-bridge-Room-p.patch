+package com.zipbug.base.tts
+
+import android.content.Context
+import com.zipbug.base.termux.TermuxBridge
+import java.io.File
+
+object EdgeTtsHelper {
+    const val VOICE_NILAR = "my-MM-NilarNeural"
+    const val VOICE_THIHA = "my-MM-ThihaNeural"
+    const val VOICE_JENNY = "en-US-JennyNeural"
+
+    val AVAILABLE_VOICES = listOf(
+        VOICE_NILAR,
+        VOICE_THIHA,
+        VOICE_JENNY
+    )
+
+    fun buildTtsCommand(
+        text: String,
+        outputFile: File,
+        voice: String = VOICE_NILAR
+    ): Pair<String, Array<String>> {
+        val tool = "edge-tts"
+        val args = arrayOf(
+            "--voice", voice,
+            "--text", text,
+            "--write-media", outputFile.absolutePath
+        )
+        return Pair(tool, args)
+    }
+
+    suspend fun generateSpeech(
+        context: Context,
+        text: String,
+        outputFile: File,
+        voice: String = VOICE_NILAR
+    ): Result<File> {
+        val (tool, args) = buildTtsCommand(text, outputFile, voice)
+        val result = TermuxBridge.executeCommand(
+            context = context,
+            tool = tool,
+            arguments = args,
+            workDir = outputFile.parentFile?.absolutePath,
+            jobType = "TTS"
+        )
+
+        return result.mapCatching {
+            outputFile
+        }
+    }
+}
