+++ b/app/src/main/java/com/zipbug/base/ui/studio/StudioFragment.kt
@@ -0,0 +1,195 @@
+package com.zipbug.base.ui.studio
+
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.content.Context
+import android.graphics.Color
+import android.os.Bundle
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.EditText
+import android.widget.FrameLayout
+import android.widget.TextView
+import androidx.core.view.isVisible
+import androidx.fragment.app.Fragment
+import com.google.android.material.button.MaterialButton
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.google.android.material.snackbar.Snackbar
+import com.zipbug.base.R
+import com.zipbug.base.studio.StudioComponent
+import com.zipbug.base.studio.StudioProject
+import com.zipbug.base.studio.StudioScreen
+import java.util.UUID
+
+class StudioFragment : Fragment() {
+
+    private val studioProject = StudioProject(
+        id = UUID.randomUUID().toString(),
+        name = "AntigravityApp",
+        screens = mutableListOf(
+            StudioScreen(id = "screen_main", name = "MainScreen")
+        )
+    )
+
+    private lateinit var canvasContainer: FrameLayout
+    private lateinit var canvasEmptyText: TextView
+    private lateinit var componentsCountText: TextView
+
+    override fun onCreateView(inflater: LayoutInflater, container: ViewGroup?, state: Bundle?): View {
+        return inflater.inflate(R.layout.fragment_studio, container, false)
+    }
+
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+        val context = requireContext()
+
+        canvasContainer = view.findViewById(R.id.canvasContainer)
+        canvasEmptyText = view.findViewById(R.id.canvasEmptyText)
+        componentsCountText = view.findViewById(R.id.componentsCountText)
+
+        val addTextButton = view.findViewById<MaterialButton>(R.id.addTextButton)
+        val addButtonButton = view.findViewById<MaterialButton>(R.id.addButtonButton)
+        val addInputButton = view.findViewById<MaterialButton>(R.id.addInputButton)
+        val exportXmlButton = view.findViewById<MaterialButton>(R.id.exportXmlButton)
+        val clearCanvasButton = view.findViewById<MaterialButton>(R.id.clearCanvasButton)
+
+        val currentScreen = studioProject.screens.first()
+
+        addTextButton.setOnClickListener {
+            val count = currentScreen.components.size + 1
+            val comp = StudioComponent(
+                id = "text_$count",
+                type = "Text",
+                name = "TextView $count",
+                x = 24f,
+                y = (count * 40).toFloat(),
+                width = 160f,
+                height = 36f,
+                text = "Text Label $count",
+                fontSize = 16f,
+                textColor = "#FFFFFF"
+            )
+            currentScreen.components.add(comp)
+            renderCanvas()
+        }
+
+        addButtonButton.setOnClickListener {
+            val count = currentScreen.components.size + 1
+            val comp = StudioComponent(
+                id = "btn_$count",
+                type = "Button",
+                name = "Button $count",
+                x = 24f,
+                y = (count * 40).toFloat(),
+                width = 140f,
+                height = 48f,
+                text = "Action $count",
+                cornerRadius = 12f
+            )
+            currentScreen.components.add(comp)
+            renderCanvas()
+        }
+
+        addInputButton.setOnClickListener {
+            val count = currentScreen.components.size + 1
+            val comp = StudioComponent(
+                id = "input_$count",
+                type = "Input",
+                name = "Input $count",
+                x = 24f,
+                y = (count * 40).toFloat(),
+                width = 200f,
+                height = 48f,
+                text = "Enter text..."
+            )
+            currentScreen.components.add(comp)
+            renderCanvas()
+        }
+
+        clearCanvasButton.setOnClickListener {
+            currentScreen.components.clear()
+            renderCanvas()
+            Snackbar.make(view, "Canvas cleared", Snackbar.LENGTH_SHORT).show()
+        }
+
+        exportXmlButton.setOnClickListener {
+            if (currentScreen.components.isEmpty()) {
+                Snackbar.make(view, "Canvas is empty. Add components first.", Snackbar.LENGTH_SHORT).show()
+                return@setOnClickListener
+            }
+            val xml = studioProject.exportToAndroidXml(currentScreen)
+            val codeView = TextView(context).apply {
+                text = xml
+                setTextIsSelectable(true)
+                setPadding(32, 32, 32, 32)
+                setTextColor(Color.WHITE)
+                textSize = 12f
+            }
+
+            MaterialAlertDialogBuilder(context)
+                .setTitle("Android XML Layout Export")
+                .setView(codeView)
+                .setPositiveButton("Copy XML") { _, _ ->
+                    val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+                    clipboard.setPrimaryClip(ClipData.newPlainText("Android XML", xml))
+                    Snackbar.make(view, "Copied XML to clipboard", Snackbar.LENGTH_SHORT).show()
+                }
+                .setNegativeButton("Close", null)
+                .show()
+        }
+
+        renderCanvas()
+    }
+
+    private fun renderCanvas() {
+        val currentScreen = studioProject.screens.first()
+        val comps = currentScreen.components
+        componentsCountText.text = "Layers: ${comps.size} components"
+        canvasEmptyText.isVisible = comps.isEmpty()
+
+        // Remove previous dynamically added views (keep empty placeholder)
+        val childCount = canvasContainer.childCount
+        for (i in childCount - 1 downTo 0) {
+            val child = canvasContainer.getChildAt(i)
+            if (child.id != R.id.canvasEmptyText) {
+                canvasContainer.removeViewAt(i)
+            }
+        }
+
+        val density = resources.displayMetrics.density
+
+        for (comp in comps) {
+            val elementView: View = when (comp.type) {
+                "Text" -> TextView(requireContext()).apply {
+                    text = comp.text
+                    setTextColor(Color.WHITE)
+                    textSize = comp.fontSize
+                }
+                "Button" -> MaterialButton(requireContext()).apply {
+                    text = comp.text
+                    cornerRadius = (comp.cornerRadius * density).toInt()
+                }
+                "Input" -> EditText(requireContext()).apply {
+                    hint = comp.text
+                    setHintTextColor(Color.GRAY)
+                    setTextColor(Color.WHITE)
+                    isEnabled = false
+                }
+                else -> View(requireContext()).apply {
+                    setBackgroundColor(Color.DKGRAY)
+                }
+            }
+
+            val params = FrameLayout.LayoutParams(
+                (comp.width * density).toInt(),
+                (comp.height * density).toInt()
+            ).apply {
+                leftMargin = (comp.x * density).toInt()
+                topMargin = (comp.y * density).toInt()
+            }
+
+            canvasContainer.addView(elementView, params)
+        }
+    }
+}
