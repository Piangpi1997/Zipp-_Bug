+package com.zipbug.base.data.db
+
+import android.content.Context
+import androidx.room.Database
+import androidx.room.Room
+import androidx.room.RoomDatabase
+import androidx.room.TypeConverter
+import androidx.room.TypeConverters
+import com.zipbug.base.data.model.BuildJob
+import com.zipbug.base.data.model.JobStatus
+
+class JobConverters {
+    @TypeConverter
+    fun fromJobStatus(status: JobStatus): String = status.name
+
+    @TypeConverter
+    fun toJobStatus(value: String): JobStatus = runCatching { JobStatus.valueOf(value) }.getOrDefault(JobStatus.QUEUED)
+}
+
+@Database(entities = [BuildJob::class], version = 1, exportSchema = false)
+@TypeConverters(JobConverters::class)
+abstract class AppDatabase : RoomDatabase() {
+    abstract fun buildJobDao(): BuildJobDao
+
+    companion object {
+        @Volatile
+        private var INSTANCE: AppDatabase? = null
+
+        fun getInstance(context: Context): AppDatabase {
+            return INSTANCE ?: synchronized(this) {
+                val instance = Room.databaseBuilder(
+                    context.applicationContext,
+                    AppDatabase::class.java,
+                    "zipbug.db"
+                ).fallbackToDestructiveMigration().build()
+                INSTANCE = instance
+                instance
+            }
+        }
+    }
+}
