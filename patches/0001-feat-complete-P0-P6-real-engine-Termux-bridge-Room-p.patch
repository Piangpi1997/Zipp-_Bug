new file mode 100644
index 0000000..2760e18
--- /dev/null
+++ b/app/src/main/java/com/zipbug/base/termux/TermuxDoctor.kt
@@ -0,0 +1,106 @@
+package com.zipbug.base.termux
+
+import android.content.Context
+import java.io.File
+
+data class DoctorCheck(
+    val title: String,
+    val commandOrCheck: String,
+    val passed: Boolean,
+    val output: String,
+    val suggestion: String? = null
+)
+
+data class DoctorReport(
+    val checks: List<DoctorCheck>,
+    val allPassed: Boolean,
+    val timestamp: Long = System.currentTimeMillis()
+)
+
+object TermuxDoctor {
+
+    fun runLocalAudit(context: Context): DoctorReport {
+        val checks = mutableListOf<DoctorCheck>()
+
+        // 1. Termux package presence
+        val termuxInstalled = TermuxPermissionHelper.isTermuxInstalled(context)
+        checks.add(
+            DoctorCheck(
+                title = "Termux Package",
+                commandOrCheck = "pm check com.termux",
+                passed = termuxInstalled,
+                output = if (termuxInstalled) "com.termux is installed" else "com.termux not found",
+                suggestion = if (!termuxInstalled) "Install Termux from F-Droid or GitHub release." else null
+            )
+        )
+
+        // 2. RUN_COMMAND Permission
+        val hasPermission = TermuxPermissionHelper.hasRunCommandPermission(context)
+        checks.add(
+            DoctorCheck(
+                title = "RUN_COMMAND Permission",
+                commandOrCheck = TermuxPermissionHelper.PERMISSION_RUN_COMMAND,
+                passed = hasPermission,
+                output = if (hasPermission) "GRANTED" else "DENIED / NOT REQUESTED",
+                suggestion = if (!hasPermission) "Grant com.termux.permission.RUN_COMMAND to Zip_Bug." else null
+            )
+        )
+
+        // 3. allow-external-apps check
+        val allowExt = TermuxPermissionHelper.checkAllowExternalApps()
+        checks.add(
+            DoctorCheck(
+                title = "termux.properties: allow-external-apps",
+                commandOrCheck = "~/.termux/termux.properties",
+                passed = allowExt == true || allowExt == null,
+                output = when (allowExt) {
+                    true -> "Configured (allow-external-apps=true)"
+                    false -> "Disabled or missing in ~/.termux/termux.properties"
+                    null -> "Sandbox isolation: verify ~/.termux/termux.properties contains allow-external-apps=true"
+                },
+                suggestion = if (allowExt == false) "Add 'allow-external-apps=true' to ~/.termux/termux.properties and run 'termux-reload-settings'" else null
+            )
+        )
+
+        // 4. Java 17 Check
+        val javaVer = System.getProperty("java.version") ?: "unknown"
+        val isJava17Plus = javaVer.startsWith("17") || javaVer.startsWith("18") || javaVer.startsWith("19") || javaVer.startsWith("21")
+        checks.add(
+            DoctorCheck(
+                title = "Java Runtime (JVM)",
+                commandOrCheck = "java -version",
+                passed = isJava17Plus,
+                output = "JVM Version: $javaVer",
+                suggestion = if (!isJava17Plus) "Java 17 (openjdk-17) is required for Android SDK 34 Gradle 8.9 builds." else null
+            )
+        )
+
+        // 5. Native AAPT2 Check (Termux environment)
+        val termuxAapt2 = File("/data/data/com.termux/files/usr/bin/aapt2")
+        val hasTermuxAapt2 = termuxAapt2.exists() && termuxAapt2.canExecute()
+        checks.add(
+            DoctorCheck(
+                title = "Native Termux aapt2",
+                commandOrCheck = "/data/data/com.termux/files/usr/bin/aapt2",
+                passed = hasTermuxAapt2 || !termuxInstalled, // Only mandatory if building natively in Termux
+                output = if (hasTermuxAapt2) "Native binary found: ${termuxAapt2.absolutePath}" else "Native Termux aapt2 binary not found at /data/data/com.termux/files/usr/bin/aapt2",
+                suggestion = if (!hasTermuxAapt2 && termuxInstalled) "Install aapt2 in Termux: pkg install aapt2 and ensure ~/.gradle/gradle.properties has android.aapt2FromMavenOverride" else null
+            )
+        )
+
+        // 6. ANDROID_HOME / ANDROID_SDK_ROOT check
+        val envSdk = System.getenv("ANDROID_HOME") ?: System.getenv("ANDROID_SDK_ROOT")
+        checks.add(
+            DoctorCheck(
+                title = "Android SDK Location",
+                commandOrCheck = "\$ANDROID_HOME / \$ANDROID_SDK_ROOT",
+                passed = !envSdk.isNullOrBlank() || File(context.filesDir, "android-sdk").exists(),
+                output = envSdk ?: "No environment variable found in current process",
+                suggestion = if (envSdk.isNullOrBlank()) "Ensure export ANDROID_HOME=\$HOME/android-sdk is in Termux ~/.bashrc" else null
+            )
+        )
+
+        val allPassed = checks.all { it.passed }
+        return DoctorReport(checks = checks, allPassed = allPassed)
+    }
+}
diff --git a/app/src/main/java/com/zipbug/base/termux/TermuxPermissionHelper.kt b/app/src/main/java/com/zipbug/base/termux/TermuxPermissionHelper.kt
new file mode 100644
