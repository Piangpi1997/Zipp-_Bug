+package com.zipbug.base.ai
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.IOException
+import java.util.concurrent.TimeUnit
+
+data class AiResponse(
+    val success: Boolean,
+    val content: String,
+    val rawJson: String? = null,
+    val status: ProviderStatus = ProviderStatus.SUCCESS,
+    val errorMessage: String? = null
+)
+
+class AiService(private val context: Context) {
+    private val client = OkHttpClient.Builder()
+        .connectTimeout(45, TimeUnit.SECONDS)
+        .readTimeout(90, TimeUnit.SECONDS)
+        .writeTimeout(45, TimeUnit.SECONDS)
+        .build()
+
+    private val jsonMediaType = "application/json; charset=utf-8".toMediaType()
+
+    suspend fun sendRequest(
+        provider: AiProvider,
+        mode: AiMode,
+        userPrompt: String,
+        modelOverride: String? = null
+    ): AiResponse = withContext(Dispatchers.IO) {
+        val apiKey = AiKeyStore.getKey(context, provider)
+        if (apiKey.isBlank()) {
+            return@withContext AiResponse(
+                success = false,
+                content = "",
+                status = ProviderStatus.NOT_CONFIGURED,
+                errorMessage = "API key not configured for ${provider.displayName}"
+            )
+        }
+
+        val model = modelOverride ?: provider.defaultModel
+
+        try {
+            when (provider) {
+                AiProvider.OPENROUTER -> callOpenRouter(apiKey, model, mode, userPrompt)
+                AiProvider.OPENAI -> callOpenAi(apiKey, model, mode, userPrompt)
+                AiProvider.GEMINI -> callGemini(apiKey, model, mode, userPrompt)
+                AiProvider.CLAUDE -> callClaude(apiKey, model, mode, userPrompt)
+            }
+        } catch (e: IOException) {
+            AiResponse(
+                success = false,
+                content = "",
+                status = ProviderStatus.PROVIDER_ERROR,
+                errorMessage = "Network error: ${e.message}"
+            )
+        } catch (e: Exception) {
+            AiResponse(
+                success = false,
+                content = "",
+                status = ProviderStatus.PROVIDER_ERROR,
+                errorMessage = e.message ?: "Unknown error"
+            )
+        }
+    }
+
+    private fun callOpenRouter(
+        apiKey: String,
+        model: String,
+        mode: AiMode,
+        prompt: String
+    ): AiResponse {
+        val payload = JSONObject().apply {
+            put("model", model)
+            val messages = JSONArray().apply {
+                put(JSONObject().apply {
+                    put("role", "system")
+                    put("content", mode.systemPrompt)
+                })
+                put(JSONObject().apply {
+                    put("role", "user")
+                    put("content", prompt)
+                })
+            }
+            put("messages", messages)
+        }
+
+        val request = Request.Builder()
+            .url(AiProvider.OPENROUTER.endpoint)
+            .addHeader("Authorization", "Bearer $apiKey")
+            .addHeader("HTTP-Referer", "https://github.com/Piangpi1997/Zipp-_Bug")
+            .addHeader("X-Title", "Zip_Bug Antigravity")
+            .post(payload.toString().toRequestBody(jsonMediaType))
+            .build()
+
+        client.newCall(request).execute().use { response ->
+            val code = response.code
+            val bodyString = response.body?.string().orEmpty()
+
+            if (code == 401 || code == 403) {
+                return AiResponse(false, "", bodyString, ProviderStatus.AUTH_ERROR, "Invalid OpenRouter API Key")
+            }
+            if (code == 429) {
+                return AiResponse(false, "", bodyString, ProviderStatus.RATE_LIMITED, "OpenRouter Rate Limited")
+            }
+            if (!response.isSuccessful) {
+                return AiResponse(false, "", bodyString, ProviderStatus.PROVIDER_ERROR, "HTTP $code: $bodyString")
+            }
+
+            val json = JSONObject(bodyString)
+            val choices = json.optJSONArray("choices")
+            if (choices != null && choices.length() > 0) {
+                val message = choices.getJSONObject(0).optJSONObject("message")
+                val content = message?.optString("content").orEmpty()
+                return AiResponse(true, content, bodyString, ProviderStatus.SUCCESS)
+            }
+
+            return AiResponse(false, "", bodyString, ProviderStatus.PROVIDER_ERROR, "Empty response from OpenRouter")
+        }
+    }
+
+    private fun callOpenAi(
+        apiKey: String,
+        model: String,
+        mode: AiMode,
+        prompt: String
+    ): AiResponse {
+        val payload = JSONObject().apply {
+            put("model", model)
+            val messages = JSONArray().apply {
+                put(JSONObject().apply {
+                    put("role", "system")
+                    put("content", mode.systemPrompt)
+                })
+                put(JSONObject().apply {
+                    put("role", "user")
+                    put("content", prompt)
+                })
+            }
+            put("messages", messages)
+        }
+
+        val request = Request.Builder()
+            .url(AiProvider.OPENAI.endpoint)
+            .addHeader("Authorization", "Bearer $apiKey")
+            .post(payload.toString().toRequestBody(jsonMediaType))
+            .build()
+
+        client.newCall(request).execute().use { response ->
+            val code = response.code
+            val bodyString = response.body?.string().orEmpty()
+
+            if (code == 401) return AiResponse(false, "", bodyString, ProviderStatus.AUTH_ERROR, "Invalid OpenAI API Key")
+            if (code == 429) return AiResponse(false, "", bodyString, ProviderStatus.RATE_LIMITED, "OpenAI Rate Limited")
+            if (!response.isSuccessful) return AiResponse(false, "", bodyString, ProviderStatus.PROVIDER_ERROR, "HTTP $code")
+
+            val json = JSONObject(bodyString)
+            val choices = json.optJSONArray("choices")
+            val content = choices?.optJSONObject(0)?.optJSONObject("message")?.optString("content").orEmpty()
+            return AiResponse(true, content, bodyString, ProviderStatus.SUCCESS)
+        }
+    }
+
+    private fun callGemini(
+        apiKey: String,
+        model: String,
+        mode: AiMode,
+        prompt: String
+    ): AiResponse {
+        val url = "https://generativelanguage.googleapis.com/v1beta/models/$model:generateContent?key=$apiKey"
+        val payload = JSONObject().apply {
+            val contents = JSONArray().apply {
+                put(JSONObject().apply {
+                    val parts = JSONArray().apply {
+                        put(JSONObject().apply {
+                            put("text", "${mode.systemPrompt}\n\n$prompt")
+                        })
+                    }
+                    put("parts", parts)
+                })
+            }
+            put("contents", contents)
+        }
+
+        val request = Request.Builder()
+            .url(url)
+            .post(payload.toString().toRequestBody(jsonMediaType))
+            .build()
+
+        client.newCall(request).execute().use { response ->
+            val code = response.code
+            val bodyString = response.body?.string().orEmpty()
+            if (code == 400 || code == 403) return AiResponse(false, "", bodyString, ProviderStatus.AUTH_ERROR, "Gemini Authentication / Request Error")
+            if (code == 429) return AiResponse(false, "", bodyString, ProviderStatus.RATE_LIMITED, "Gemini Rate Limited")
+            if (!response.isSuccessful) return AiResponse(false, "", bodyString, ProviderStatus.PROVIDER_ERROR, "HTTP $code")
+
+            val json = JSONObject(bodyString)
+            val candidates = json.optJSONArray("candidates")
+            val text = candidates?.optJSONObject(0)?.optJSONObject("content")?.optJSONArray("parts")?.optJSONObject(0)?.optString("text").orEmpty()
+            return AiResponse(true, text, bodyString, ProviderStatus.SUCCESS)
+        }
+    }
+
+    private fun callClaude(
+        apiKey: String,
+        model: String,
+        mode: AiMode,
+        prompt: String
+    ): AiResponse {
+        val payload = JSONObject().apply {
+            put("model", model)
+            put("max_tokens", 4096)
+            put("system", mode.systemPrompt)
+            val messages = JSONArray().apply {
+                put(JSONObject().apply {
+                    put("role", "user")
+                    put("content", prompt)
+                })
+            }
+            put("messages", messages)
+        }
+
+        val request = Request.Builder()
+            .url(AiProvider.CLAUDE.endpoint)
+            .addHeader("x-api-key", apiKey)
+            .addHeader("anthropic-version", "2023-06-01")
+            .post(payload.toString().toRequestBody(jsonMediaType))
+            .build()
+
+        client.newCall(request).execute().use { response ->
+            val code = response.code
+            val bodyString = response.body?.string().orEmpty()
+            if (code == 401) return AiResponse(false, "", bodyString, ProviderStatus.AUTH_ERROR, "Invalid Claude API Key")
+            if (code == 429) return AiResponse(false, "", bodyString, ProviderStatus.RATE_LIMITED, "Claude Rate Limited")
+            if (!response.isSuccessful) return AiResponse(false, "", bodyString, ProviderStatus.PROVIDER_ERROR, "HTTP $code")
+
+            val json = JSONObject(bodyString)
+            val contentArr = json.optJSONArray("content")
+            val text = contentArr?.optJSONObject(0)?.optString("text").orEmpty()
+            return AiResponse(true, text, bodyString, ProviderStatus.SUCCESS)
+        }
+    }
+}
