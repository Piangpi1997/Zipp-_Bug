--- /dev/null
+++ b/app/src/main/java/com/zipbug/base/termux/TermuxPermissionHelper.kt
@@ -0,0 +1,52 @@
+package com.zipbug.base.termux
+
+import android.content.Context
+import android.content.pm.PackageManager
+import androidx.core.content.ContextCompat
+import java.io.File
+
+object TermuxPermissionHelper {
+    const val PERMISSION_RUN_COMMAND = "com.termux.permission.RUN_COMMAND"
+    const val TERMUX_PACKAGE_NAME = "com.termux"
+
+    fun isTermuxInstalled(context: Context): Boolean {
+        return try {
+            context.packageManager.getPackageInfo(TERMUX_PACKAGE_NAME, 0)
+            true
+        } catch (_: PackageManager.NameNotFoundException) {
+            false
+        }
+    }
+
+    fun hasRunCommandPermission(context: Context): Boolean {
+        return ContextCompat.checkSelfPermission(
+            context,
+            PERMISSION_RUN_COMMAND
+        ) == PackageManager.PERMISSION_GRANTED
+    }
+
+    /**
+     * Checks if ~/.termux/termux.properties has allow-external-apps = true
+     * When running inside Termux or checking file system if accessible.
+     */
+    fun checkAllowExternalApps(): Boolean? {
+        val candidates = listOf(
+            File("/data/data/com.termux/files/home/.termux/termux.properties"),
+            File(System.getProperty("user.home", ""), ".termux/termux.properties")
+        )
+        for (file in candidates) {
+            if (file.exists() && file.canRead()) {
+                val content = runCatching { file.readText() }.getOrNull() ?: continue
+                for (line in content.lines()) {
+                    val trimmed = line.trim()
+                    if (trimmed.startsWith("#")) continue
+                    if (trimmed.replace(" ", "").contains("allow-external-apps=true")) {
+                        return true
+                    }
+                }
+                return false
+            }
+        }
+        return null // Cannot access Termux home directly from sandbox
+    }
+}
