<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/z_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Social Recap Lab"
        android:textColor="@color/z_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/url"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Movie / social link"
        android:textColor="@color/z_text"
        android:textColorHint="@color/z_muted" />

    <EditText
        android:id="@+id/language"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Myanmar"
        android:textColor="@color/z_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/recap"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Recap" />

        <Button
            android:id="@+id/dialogue"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="+Dialogue" />

        <Button
            android:id="@+id/dub"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Dub" />
    </LinearLayout>

    <EditText
        android:id="@+id/output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:textColor="@color/z_text" />
</LinearLayout>
