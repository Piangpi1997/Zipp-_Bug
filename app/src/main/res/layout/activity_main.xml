<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/z_bg">

    <!-- ==================== MAIN CHAT INTERFACE ==================== -->
    <LinearLayout
        android:id="@+id/mainChatContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. Compact Header -->
        <LinearLayout
            android:id="@+id/chatTopHeader"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@color/z_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Left: Sidebar Button -->
            <ImageButton
                android:id="@+id/btnNavDrawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open Sidebar"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/z_text" />

            <!-- Center: Logo + Model Selector Pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_zipbug_logo" />

                <!-- Model Selector Pill -->
                <LinearLayout
                    android:id="@+id/btnModelSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvCurrentModelLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OpenRouter Free"
                        android:textColor="@color/z_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Select Model"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/z_muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: New Chat (+) and Overflow/Settings -->
            <ImageButton
                android:id="@+id/btnNewChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_new_chat"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                app:tint="@color/z_orange" />

            <ImageButton
                android:id="@+id/btnHeaderOverflow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings_gear"
                app:tint="@color/z_text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/z_border" />

        <!-- 2. Conversation Body & Empty State Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Empty State (Shown when message count == 0) -->
            <LinearLayout
                android:id="@+id/layoutChatEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <!-- Brand Emblem -->
                <FrameLayout
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_icon_badge_orange">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_zipbug_logo" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvChatGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/chat_greeting"
                    android:textColor="@color/z_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 4 Compact Suggestion Chips (2x2 Grid) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <!-- Row 1: App | Code -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipSuggestApp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:text="@string/chat_suggestion_app"
                            android:textColor="@color/z_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipSuggestCode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:text="@string/chat_suggestion_code"
                            android:textColor="@color/z_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Row 2: Website | File -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipSuggestWeb"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:text="@string/chat_suggestion_web"
                            android:textColor="@color/z_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipSuggestFile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:text="@string/chat_suggestion_file"
                            android:textColor="@color/z_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Scrolling Conversation Messages -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChatMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:paddingTop="8dp"
                android:scrollbars="vertical" />
        </FrameLayout>

        <!-- 3. Attached Tool / Task Context Bar (if attached) -->
        <LinearLayout
            android:id="@+id/layoutAttachmentBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/z_surface_subtle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAttachmentChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/z_orange"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRemoveAttachment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="✕"
                android:textColor="@color/z_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 4. Floating Rounded Message Composer -->
        <LinearLayout
            android:id="@+id/composerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingBottom="12dp"
            android:paddingTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_composer"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <!-- "+" Attachment / Tools Button -->
                <ImageButton
                    android:id="@+id/btnAttachTool"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Attach Tool"
                    android:padding="8dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/z_muted" />

                <!-- Multiline Message Input -->
                <EditText
                    android:id="@+id/etChatMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/chat_composer_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:minHeight="40dp"
                    android:textColor="@color/z_text"
                    android:textColorHint="@color/z_muted"
                    android:textSize="14sp" />

                <!-- Send / Stop Button -->
                <ImageButton
                    android:id="@+id/btnSendStop"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Send Message"
                    android:padding="7dp"
                    android:src="@drawable/ic_send"
                    app:tint="@color/z_orange" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== LEFT SIDEBAR DRAWER ==================== -->
    <LinearLayout
        android:id="@+id/sidebarDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/z_surface"
        android:orientation="vertical">

        <!-- Sidebar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Brand"
                android:src="@drawable/ic_zipbug_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="ZIP_BUG STUDIO"
                android:textColor="@color/z_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- New Chat Primary Action Button -->
        <LinearLayout
            android:id="@+id/btnDrawerNewChat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chip_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="New Chat"
                android:src="@drawable/ic_add"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/chat_new_chat"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Bar for Chat History -->
        <EditText
            android:id="@+id/etSearchChats"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search_bar"
            android:hint="Search chats…"
            android:importantForAutofill="no"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:text="@string/chat_history_title"
            android:textColor="@color/z_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Chat History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/z_border" />

        <!-- Studio & Workspaces Shortcuts -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="180dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <!-- + New App / အက်ပ်အသစ် -->
                <LinearLayout
                    android:id="@+id/drawerItemNewApp"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="New App"
                        android:src="@drawable/ic_add"
                        app:tint="@color/z_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/drawer_new_app"
                        android:textColor="@color/z_text"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Projects -->
                <LinearLayout
                    android:id="@+id/drawerItemProjects"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Projects"
                        android:src="@drawable/ic_nav_projects"
                        app:tint="@color/z_orange" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Projects &amp; Runtime"
                        android:textColor="@color/z_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Visual Studio -->
                <LinearLayout
                    android:id="@+id/drawerItemStudio"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Visual Studio"
                        android:src="@drawable/ic_nav_studio"
                        app:tint="@color/z_purple" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Visual Studio"
                        android:textColor="@color/z_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- React & Web -->
                <LinearLayout
                    android:id="@+id/drawerItemReact"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="React and Web"
                        android:src="@drawable/ic_tool_react_web"
                        app:tint="@color/z_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="React &amp; Web"
                        android:textColor="@color/z_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- APK Builder -->
                <LinearLayout
                    android:id="@+id/drawerItemBuild"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="APK Builder"
                        android:src="@drawable/ic_nav_build"
                        app:tint="@color/z_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="APK Builder"
                        android:textColor="@color/z_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Audio & Voice -->
                <LinearLayout
                    android:id="@+id/drawerItemAudio"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Audio"
                        android:src="@drawable/ic_tool_audio_voice"
                        app:tint="@color/z_orange" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Audio &amp; TTS"
                        android:textColor="@color/z_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Video Recap -->
                <LinearLayout
                    android:id="@+id/drawerItemVideo"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Video"
                        android:src="@drawable/ic_tool_video_recap"
                        app:tint="@color/z_red" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Video Recap"
                        android:textColor="@color/z_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Dev Tools -->
                <LinearLayout
                    android:id="@+id/drawerItemDevTools"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Utilities"
                        android:src="@drawable/ic_tool_utilities"
                        app:tint="@color/z_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Developer Utilities"
                        android:textColor="@color/z_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/z_border" />

        <!-- Sidebar Footer (Engine Status + Settings) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/btnDrawerEngineStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDrawerEngineDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/z_green"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvDrawerEngineState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/engine_badge_ready"
                    android:textColor="@color/z_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDrawerSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings_gear"
                app:tint="@color/z_text" />
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
