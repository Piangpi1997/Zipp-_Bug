<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/z_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Creator"
            android:textColor="@color/z_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Generate Android, mini-app, React + Vite, or React Native + Expo source ZIPs."
            android:textColor="@color/z_muted" />

        <EditText
            android:id="@+id/appName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="App name"
            android:text="My ZipBug App"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <EditText
            android:id="@+id/packageName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Package name"
            android:text="com.example.zipbugapp"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <EditText
            android:id="@+id/goal"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="top"
            android:hint="What should this app become?"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <Button
            android:id="@+id/createAndroid"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Create Kotlin/XML Android ZIP" />

        <EditText
            android:id="@+id/htmlContent"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"
            android:gravity="top"
            android:hint="Paste your HTML here for the HTML App (optional — a starter page is generated if empty)"
            android:inputType="textMultiLine"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/webFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fullscreen"
                android:textColor="@color/z_text" />

            <CheckBox
                android:id="@+id/webKeepScreenOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Keep screen on"
                android:textColor="@color/z_text" />
        </LinearLayout>

        <Button
            android:id="@+id/createHtmlApp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="Create HTML App — Android ZIP (WebView)" />

        <Button
            android:id="@+id/createWeb"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="Create HTML/JS/JSON Mini-App ZIP" />

        <Button
            android:id="@+id/createReact"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="Create React + Vite Source ZIP" />

        <Button
            android:id="@+id/createReactNative"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="Create React Native + Expo Source ZIP" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="React source ZIPs are source-only. Zip_Bug will not auto-run npm/npx lifecycle scripts from imported projects."
            android:textColor="@color/z_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/z_surface"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="No project generated yet."
            android:textColor="@color/z_green"
            android:textIsSelectable="true" />

        <LinearLayout
            android:id="@+id/exportActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/openExport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Open ZIP" />

            <Button
                android:id="@+id/shareExport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Share ZIP" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
