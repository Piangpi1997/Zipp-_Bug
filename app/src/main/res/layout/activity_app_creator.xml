<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/z_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_34c17649da"
            android:textColor="@color/z_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/ui_e8a3b9e600"
            android:textColor="@color/z_muted" />

        <EditText
            android:id="@+id/appName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ui_c877cbb0e8"
            android:text="@string/ui_c5d4a34842"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <EditText
            android:id="@+id/packageName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ui_d6406a8838"
            android:text="@string/ui_1aa364b2df"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <EditText
            android:id="@+id/goal"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="top"
            android:hint="@string/ui_cbaba8f67d"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <Button
            android:id="@+id/createAndroid"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/ui_a5dbb4caba" />

        <Button
            android:id="@+id/createWeb"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="@string/ui_c9aeb2e77b" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/z_surface"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="@string/ui_f3f0e40c70"
            android:textColor="@color/z_green"
            android:textIsSelectable="true" />

        <LinearLayout
            android:id="@+id/exportActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/openExport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/ui_b6c14496c7" />

            <Button
                android:id="@+id/shareExport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/ui_9aa942bf6b" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
