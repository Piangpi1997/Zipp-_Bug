<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_chip_inactive" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_model_sheet_title"
        android:textColor="@color/z_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Choose an AI intelligence model for code generation and engineering assistance"
        android:textColor="@color/z_muted"
        android:textSize="12sp" />

    <!-- Model Option 1: OpenRouter Free -->
    <LinearLayout
        android:id="@+id/modelOptionOpenRouter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_active"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenRouter • Free"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="openrouter/free • Llama 3.3 70B &amp; Free tier"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadgeOpenRouter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2E2010"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="ACTIVE"
            android:textColor="@color/z_orange"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Model Option 2: Gemini 2.5 Flash -->
    <LinearLayout
        android:id="@+id/modelOptionGemini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_inactive"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Gemini"
                android:textColor="@color/z_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="gemini-2.5-flash • High speed code reasoning"
                android:textColor="@color/z_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadgeGemini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/z_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Model Option 3: OpenAI GPT-4o-mini -->
    <LinearLayout
        android:id="@+id/modelOptionOpenAi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_inactive"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenAI"
                android:textColor="@color/z_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="gpt-4.1-mini • Versatile developer assistant"
                android:textColor="@color/z_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadgeOpenAi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/z_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Model Option 4: Claude 3.5 Sonnet -->
    <LinearLayout
        android:id="@+id/modelOptionClaude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_inactive"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anthropic Claude"
                android:textColor="@color/z_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="claude-sonnet-4-5 • Advanced architecture and design"
                android:textColor="@color/z_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadgeClaude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/z_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Configure Keys Footer Action -->
    <Button
        android:id="@+id/btnSheetConfigureKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/z_orange"
        android:text="@string/chat_configure_keys"
        android:textAllCaps="false"
        android:textColor="@color/z_white"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
