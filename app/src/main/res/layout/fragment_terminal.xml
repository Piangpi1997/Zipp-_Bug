<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Termux Build Engine"
        android:textColor="@color/z_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/engineState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ENGINE • IDLE"
        android:textColor="@color/z_green"
        android:textStyle="bold" />

    <!-- Test Panel: Python, Java, Gradle, ffmpeg, aapt2 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="COMMAND TEST PANEL"
        android:textColor="@color/z_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/testPython"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Python"
            android:textSize="12sp" />

        <Button
            android:id="@+id/testJava"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Java"
            android:textSize="12sp" />

        <Button
            android:id="@+id/testGradle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Gradle"
            android:textSize="12sp" />

        <Button
            android:id="@+id/testFfmpeg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="ffmpeg"
            android:textSize="12sp" />

        <Button
            android:id="@+id/testAapt2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="aapt2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/doctor"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Engine Diagnostics (15 Checks)"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buildApk"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="/apkbuilder"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/command"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:hint="/termux [tool] [args]"
        android:singleLine="true"
        android:textColor="@color/z_text"
        android:textColorHint="@color/z_muted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/run"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="Run Command" />

    <TextView
        android:id="@+id/output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#101010"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:text="Real stdout / stderr / exitCode will appear here."
        android:textColor="@color/z_green"
        android:textIsSelectable="true"
        android:textSize="13sp" />
</LinearLayout>
