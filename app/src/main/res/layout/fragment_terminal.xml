<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_aedff2a425"
        android:textColor="@color/z_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/engineState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ui_aef68539da"
        android:textColor="@color/z_green"
        android:textStyle="bold" />

    <!-- Test Panel: Python, Java, Gradle, ffmpeg, aapt2 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ui_c2bb2f1d2a"
        android:textColor="@color/z_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/testPython"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/ui_6e3604888c"
            android:textSize="12sp" />

        <Button
            android:id="@+id/testJava"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/ui_e027e57610"
            android:textSize="12sp" />

        <Button
            android:id="@+id/testGradle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/ui_f426be61bd"
            android:textSize="12sp" />

        <Button
            android:id="@+id/testFfmpeg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/ui_037917f6f7"
            android:textSize="12sp" />

        <Button
            android:id="@+id/testAapt2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/ui_a37566242d"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDeviceProof"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/ui_db106a25c3"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buildApk"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/ui_e25f95a8e8"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/releaseApk"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/ui_05ab059a2b"
            android:textSize="11sp" />

        <Button
            android:id="@+id/cancelBuild"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/ui_a58b61b399"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/buildStages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/z_surface"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:text="@string/ui_5a00511859"
        android:textColor="@color/z_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/artifactActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/openArtifact"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/ui_64e6758c6f"
            android:textSize="11sp" />

        <Button
            android:id="@+id/shareArtifact"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/ui_addb5ae9df"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/command"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:hint="@string/ui_519e4f8b69"
        android:singleLine="true"
        android:textColor="@color/z_text"
        android:textColorHint="@color/z_muted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/run"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="@string/ui_0bc4731fb1" />

    <TextView
        android:id="@+id/output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#101010"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:text="@string/ui_9f1f4fa6ef"
        android:textColor="@color/z_green"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnFixErrorWithAi"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="@color/z_orange"
        android:text="@string/ui_b04389cd2a"
        android:textColor="#111111"
        android:visibility="gone" />
</LinearLayout>
