<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/z_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TTS Studio"
            android:textColor="@color/z_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="TTS • IDLE"
            android:textColor="@color/z_green"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Myanmar text…"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/femaleVoice"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Nilar • Female" />

            <Button
                android:id="@+id/maleVoice"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Thiha • Male" />
        </LinearLayout>

        <EditText
            android:id="@+id/voice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Edge voice"
            android:singleLine="true"
            android:text="my-MM-NilarNeural"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <EditText
            android:id="@+id/outputPath"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Output MP3 path"
            android:singleLine="true"
            android:text="/storage/emulated/0/Download/Zip_Bug_TTS.mp3"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <Button
            android:id="@+id/installEdgeTts"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Setup / Upgrade edge-tts in Termux" />

        <Button
            android:id="@+id/generate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="Generate Real MP3" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="#101010"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="Real Termux stdout / stderr appears here."
            android:textColor="@color/z_green"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
