<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/z_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_82dad51824"
            android:textColor="@color/z_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ui_96f5001ad5"
            android:textColor="@color/z_green"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="@string/ui_b2e98317a1"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/femaleVoice"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/ui_6e8b1bbf13" />

            <Button
                android:id="@+id/maleVoice"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/ui_adfbb02a9c" />
        </LinearLayout>

        <EditText
            android:id="@+id/voice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ui_2743a089d5"
            android:singleLine="true"
            android:text="@string/ui_e813a5888f"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <EditText
            android:id="@+id/outputPath"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ui_2f41a09bae"
            android:singleLine="true"
            android:text="@string/ui_d6b2a3fad2"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <Button
            android:id="@+id/installEdgeTts"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/ui_46399ec612" />

        <Button
            android:id="@+id/generate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="@string/ui_89f9365bae" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="#101010"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="@string/ui_e152cc7a78"
            android:textColor="@color/z_green"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
