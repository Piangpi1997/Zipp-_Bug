<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/z_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_badge_orange"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_tool_audio_voice" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio &amp; Voice Studio"
                        android:textColor="@color/z_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="TTS • IDLE"
                        android:textColor="@color/z_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Step 1: Narration Script Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. NARRATION SCRIPT"
                android:textColor="@color/z_orange"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="top"
                android:hint="Enter Myanmar, English, Thai, or Chinese narration text…"
                android:padding="12dp"
                android:textColor="@color/z_text"
                android:textColorHint="@color/z_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Step 2: Voice & Language Selection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. VOICE &amp; TUNING"
                android:textColor="@color/z_orange"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/femaleVoice"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_active"
                    android:text="Nilar (MY)"
                    android:textAllCaps="false"
                    android:textColor="@color/z_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/maleVoice"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="Thiha (MY)"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/englishVoice"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="Jenny (EN)"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/thaiVoice"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="Premwadee (TH)"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chineseVoice"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="Xiaoxiao (ZH)"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/voice"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:hint="Edge voice"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:text="my-MM-NilarNeural"
                android:textColor="@color/z_text"
                android:textColorHint="@color/z_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/rate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:hint="Speed (e.g. +0%)"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:text="+0%"
                    android:textColor="@color/z_text"
                    android:textColorHint="@color/z_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/pitch"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:hint="Pitch (e.g. +0Hz)"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:text="+0Hz"
                    android:textColor="@color/z_text"
                    android:textColorHint="@color/z_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/outputPath"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:hint="Output MP3 path"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:text="/storage/emulated/0/Download/Zip_Bug_TTS.mp3"
                android:textColor="@color/z_text"
                android:textColorHint="@color/z_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Step 3: Primary Action & Playback Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. SYNTHESIZE &amp; EXPORT"
                android:textColor="@color/z_orange"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreview"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="Preview (Short)"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/generate"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.3"
                    android:backgroundTint="@color/z_orange"
                    android:text="Generate MP3"
                    android:textAllCaps="false"
                    android:textColor="@color/z_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Playback Row (Shown when MP3 is ready) -->
            <LinearLayout
                android:id="@+id/actionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnPlayInApp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_active"
                    android:text="▶ Play In-App"
                    android:textAllCaps="false"
                    android:textColor="@color/z_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlayAudio"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="External Player"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnShareAudio"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="Share Audio"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Script / Subtitle Export Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTtsExportTxt"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="Export TXT"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnTtsExportSrt"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="Export SRT"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnTtsExportVtt"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                    android:text="Export VTT"
                    android:textAllCaps="false"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/installEdgeTts"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                app:backgroundTint="@null"
                    android:background="@drawable/bg_chip_inactive"
                android:text="Setup / Upgrade edge-tts in Termux"
                android:textAllCaps="false"
                android:textColor="@color/z_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Execution Output Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYNTHESIS LOG"
                android:textColor="@color/z_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search_bar"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text="Real Termux stdout / stderr appears here."
                android:textColor="@color/z_green"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
