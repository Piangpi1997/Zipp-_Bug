<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_c0e96bcc8e"
            android:textColor="@color/z_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ui_4522a05a0e"
            android:textColor="@color/z_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/z_surface"
            android:padding="16dp"
            android:text="@string/ui_fdb18f439b"
            android:textColor="@color/z_green"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/ui_9b8dfdff73"
            android:textColor="@color/z_orange"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/appCreator"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/ui_6cf2e5e831" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_5cf05677c9"
            android:textColor="@color/z_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/apkBuilder"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="@string/ui_c9d4072e89" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_3aaa2ae8f1"
            android:textColor="@color/z_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ui_8d2fccfa70"
            android:textColor="@color/z_orange"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/studio"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/ui_09cfea6df8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_c1c43dc3fa"
            android:textColor="@color/z_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/aiCreator"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="@string/ui_46cc6b4e9f" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_5c04db4781"
            android:textColor="@color/z_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ui_b85fa29e83"
            android:textColor="@color/z_orange"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ttsStudio"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/ui_6f804fd7a2" />

        <Button
            android:id="@+id/mediaRecap"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="@string/ui_2c65b1e39d" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ui_9d0e510bd5"
            android:textColor="@color/z_orange"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/ui_c7f5e022ca" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_8b7daa21ee"
            android:textColor="@color/z_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/commandHelp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="@string/ui_8d162006ff" />

        <Button
            android:id="@+id/projects"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="@string/ui_d1dc718b37" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/z_surface"
            android:padding="12dp"
            android:text="@string/ui_e164709b6d"
            android:textColor="@color/z_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
