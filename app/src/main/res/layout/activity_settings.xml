<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/z_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language_title"
            android:textColor="@color/z_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/language_description"
            android:textColor="@color/z_muted" />

        <RadioGroup
            android:id="@+id/languageOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/languageEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_english"
                android:textColor="@color/z_text" />

            <RadioButton
                android:id="@+id/languageBurmese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_burmese"
                android:textColor="@color/z_text" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_74a0809945"
            android:textColor="@color/z_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/ui_a5fa75a0bf"
            android:textColor="@color/z_muted" />

        <EditText
            android:id="@+id/openrouter"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ui_8b71ad2c77"
            android:inputType="textPassword"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/openrouterReveal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/ui_90c0c2eb98" />

            <Button
                android:id="@+id/openrouterCopy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_af74f7c536" />
        </LinearLayout>

        <EditText
            android:id="@+id/openai"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="@string/ui_a210cfc794"
            android:inputType="textPassword"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/openaiReveal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/ui_90c0c2eb98" />

            <Button
                android:id="@+id/openaiCopy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_af74f7c536" />
        </LinearLayout>

        <EditText
            android:id="@+id/gemini"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="@string/ui_ef66ea16d7"
            android:inputType="textPassword"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/geminiReveal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/ui_90c0c2eb98" />

            <Button
                android:id="@+id/geminiCopy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_af74f7c536" />
        </LinearLayout>

        <EditText
            android:id="@+id/anthropic"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="@string/ui_4daacf467b"
            android:inputType="textPassword"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/anthropicReveal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/ui_90c0c2eb98" />

            <Button
                android:id="@+id/anthropicCopy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_af74f7c536" />
        </LinearLayout>

        <Button
            android:id="@+id/backupKeys"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/ui_83db78c040" />

        <Button
            android:id="@+id/restoreKeys"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/ui_0b1306a97d" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ui_cbda7c58ee"
            android:textColor="@color/z_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ui_cd235eca31"
            android:textColor="@color/z_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/termuxHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ui_c0b3407607"
            android:singleLine="true"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <EditText
            android:id="@+id/projectRoot"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ui_16bdca9c1c"
            android:singleLine="true"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <EditText
            android:id="@+id/artifactExportPath"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ui_d9fe29a097"
            android:singleLine="true"
            android:textColor="@color/z_text"
            android:textColorHint="@color/z_muted" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/ui_b727524800" />
    </LinearLayout>
</ScrollView>
