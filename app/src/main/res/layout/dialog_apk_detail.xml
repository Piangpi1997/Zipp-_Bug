<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/z_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_023f5d2431"
            android:textColor="@color/z_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/safetyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2E382E"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/ui_25ba44ec3b"
            android:textColor="@color/z_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/conflictWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#33FF4D4D"
        android:padding="10dp"
        android:text="@string/ui_02aee09d81"
        android:textColor="@color/z_red"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="320dp">

        <TextView
            android:id="@+id/metadataText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/z_text"
            android:textSize="12sp"
            tools:text="Package: com.zipbug.base\nVersion: 1.0.0 (1)" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/z_surface"
            android:text="@string/ui_77dfd2135f"
            android:textColor="@color/z_muted" />

        <Button
            android:id="@+id/btnAppInfo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#2D2D2D"
            android:text="@string/ui_1f80e11865"
            android:textColor="@color/z_text"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUninstall"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/z_red"
            android:text="@string/ui_a5a409475d"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnInstall"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/z_green"
            android:text="@string/ui_319e7e6af3"
            android:textColor="#111111" />
    </LinearLayout>
</LinearLayout>
