<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/z_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/patchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Repair • Proposed Patch"
        android:textColor="@color/z_orange"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/targetFileInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/z_text"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Target: app/src/main/java/MainActivity.kt" />

    <TextView
        android:id="@+id/patchExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/z_muted"
        android:textSize="12sp"
        tools:text="Fixes unresolved reference by updating import statements." />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Original Snippet (-)"
        android:textColor="@color/z_red"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/originalSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#2E1C1C"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@color/z_red"
        android:textSize="11sp"
        tools:text="val x = undefinedVar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Replacement Snippet (+)"
        android:textColor="@color/z_green"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/replacementSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#1C2E21"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@color/z_green"
        android:textSize="11sp"
        tools:text="val x = definedVar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelPatch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/z_surface"
            android:text="Cancel"
            android:textColor="@color/z_muted" />

        <Button
            android:id="@+id/btnApplyPatch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/z_green"
            android:text="Apply &amp; Rebuild"
            android:textColor="#111111" />
    </LinearLayout>
</LinearLayout>
