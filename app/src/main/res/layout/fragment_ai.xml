<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_dc235bc727"
        android:textColor="@color/z_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/provider"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHealthCheck"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#2D2D2D"
            android:text="@string/ui_132e2f8d48"
            android:textColor="@color/z_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/providerHealthBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#202020"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/ui_478924ce59"
            android:textColor="@color/z_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/maskedKeyPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/z_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <Spinner
        android:id="@+id/mode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/model"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:hint="@string/ui_1cde0652f2"
        android:textColor="@color/z_text"
        android:textColorHint="@color/z_muted" />

    <EditText
        android:id="@+id/prompt"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="4dp"
        android:gravity="top"
        android:hint="@string/ui_e036e004cc"
        android:textColor="@color/z_text"
        android:textColorHint="@color/z_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/send"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/ui_fc45f9b7a9" />

        <Button
            android:id="@+id/copy"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:text="@string/ui_af74f7c536" />

        <Button
            android:id="@+id/reviewAction"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:text="@string/ui_bcde7b414c"
            android:visibility="gone" />
    </LinearLayout>

    <EditText
        android:id="@+id/output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@color/z_surface"
        android:fontFamily="monospace"
        android:gravity="top"
        android:padding="12dp"
        android:textColor="@color/z_text" />
</LinearLayout>
