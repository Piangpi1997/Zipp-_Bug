<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/z_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/reviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI App Creator • Review Spec"
        android:textColor="@color/z_orange"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/projectSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/z_text"
        android:textSize="13sp"
        tools:text="Name: MyApp\nPackage: com.example.myapp\nTarget: ANDROID_KOTLIN" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="260dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Permissions"
                android:textColor="@color/z_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/z_text"
                android:textSize="12sp"
                tools:text="• android.permission.INTERNET" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dependencies"
                android:textColor="@color/z_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dependenciesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/z_text"
                android:textSize="12sp"
                tools:text="• androidx.core:core-ktx:1.13.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File Plan"
                android:textColor="@color/z_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filePlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/z_green"
                android:textSize="11sp"
                tools:text="app/src/main/java/MainActivity.kt (1.2 KB)" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditSpec"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#2D2D2D"
            android:text="Edit Spec"
            android:textColor="@color/z_text"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnRegenerate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#2D2D2D"
            android:text="Regenerate"
            android:textColor="@color/z_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGenerateProject"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/z_orange"
            android:text="Generate Project"
            android:textColor="#111111"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnBuildProject"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/z_green"
            android:enabled="false"
            android:text="Build Project"
            android:textColor="#111111"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
