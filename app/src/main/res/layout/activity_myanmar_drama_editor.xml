<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/z_bg"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/z_surface"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            app:tint="@color/z_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="မြန်မာဒရာမာ တည်းဖြတ်စနစ်"
                android:textColor="@color/z_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00 / 00:00 • 9:16 Vertical"
                android:textColor="@color/z_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveDraft"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="8dp"
            android:text="သိမ်းမည်"
            android:textColor="@color/z_orange"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnExport"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/z_orange"
            android:paddingHorizontal="12dp"
            android:text="ထုတ်မည် ↗"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 9:16 VERTICAL VIDEO PREVIEW CONTAINER -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="#000000">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Top Drama Title Badge -->
        <TextView
            android:id="@+id/tvPreviewDramaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_glass_card"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="အမုန်းသင့်အချစ် — အပိုင်း ၁"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Watermark / Logo -->
        <ImageView
            android:id="@+id/ivPreviewLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:src="@drawable/logo_horrible_hound"
            android:visibility="visible" />

        <!-- Blur Box Overlay -->
        <FrameLayout
            android:id="@+id/viewPreviewBlur"
            android:layout_width="90dp"
            android:layout_height="60dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="140dp"
            android:layout_marginTop="60dp"
            android:background="@drawable/bg_panel_outline"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#99000000"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:text="[မှုန်ဝါးခြင်း Blur]"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Subtitles Overlay -->
        <LinearLayout
            android:id="@+id/llSubtitleOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvPreviewSubMm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="မင်း ဘာလို့ ငါ့ကို လိမ်ညာခဲ့ရတာလဲ..."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreviewSubEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Why did you lie to me all this time...?"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Floating Play/Pause Button -->
        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_panel_no_outline"
            android:src="@android:drawable/ic_media_play"
            app:tint="@android:color/white" />

        <!-- Seek Bar -->
        <SeekBar
            android:id="@+id/sbVideoProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="16dp"
            android:max="1000"
            android:progressTint="@color/z_orange"
            android:thumbTint="@color/z_orange" />
    </FrameLayout>

    <!-- TIMELINE SECTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161619"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTimelineInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TIMELINE: 0/9 SOURCE VIDEOS"
                android:textColor="@color/z_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSplitClip"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="8dp"
                android:text="✂ ဖြတ်မည်"
                android:textColor="@color/z_text"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAddVideo"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/z_orange"
                android:paddingHorizontal="8dp"
                android:text="+ ဗီဒီယိုထည့်"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Horizontal Clips Track -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llClipTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- TOOL TABS BAR -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/z_surface"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabClips"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="တည်းဖြတ်"
                android:textColor="@color/z_orange"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tabSubtitles"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="စာတန်းထိုး"
                android:textColor="@color/z_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabText"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="စာသား"
                android:textColor="@color/z_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabBlur"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="မှုန်ဝါးခြင်း"
                android:textColor="@color/z_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabLogo"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="လိုဂို"
                android:textColor="@color/z_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabAudio"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="အသံ"
                android:textColor="@color/z_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- CONTEXTUAL PANEL VIEW FLIPPER -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/z_bg"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/llToolPanelContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 1. CLIPS / TRIM PANEL -->
            <LinearLayout
                android:id="@+id/panelClips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvClipDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ရွေးချယ်ထားသော ဗီဒီယို: VIDEO #1"
                    android:textColor="@color/z_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvClipTiming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="အစ: 0.0s | အဆုံး: 0.0s | ကြာချိန်: 0.0s"
                    android:textColor="@color/z_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTrimStartPlus"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Trim Start +0.5s"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnTrimEndMinus"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Trim End -0.5s"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnDeleteClip"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:text="🗑 ရွေးထားသော Segment ဖျက်ပစ်မည်"
                    android:textColor="#EF4444"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 2. SUBTITLES PANEL -->
            <LinearLayout
                android:id="@+id/panelSubtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="စာတန်းထိုးစနစ် (Dual Subtitles)"
                        android:textColor="@color/z_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAutoCaption"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="#2D201A"
                        android:text="✨ Auto Caption"
                        android:textColor="@color/z_orange"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Timing Nudges: -0.5s, -0.3s, +0.1s, +0.3s -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="အချိန်ညှိရန် (Timing Nudges):"
                    android:textColor="@color/z_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNudgeMinus05"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:text="-0.5s"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnNudgeMinus03"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:text="-0.3s"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnNudgePlus01"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:text="+0.1s"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnNudgePlus03"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:text="+0.3s"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etSubMm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_panel_no_outline"
                    android:hint="မြန်မာစာတန်းထိုး ရိုက်ထည့်ပါ..."
                    android:padding="8dp"
                    android:textColor="@color/z_text"
                    android:textColorHint="@color/z_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etSubEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_panel_no_outline"
                    android:hint="English Subtitle..."
                    android:padding="8dp"
                    android:textColor="#E2E8F0"
                    android:textColorHint="@color/z_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 3. TEXT PANEL -->
            <LinearLayout
                android:id="@+id/panelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ခေါင်းစဉ်စာသား (Episode Title Overlay)"
                    android:textColor="@color/z_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDramaTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_panel_no_outline"
                    android:hint="ဇာတ်လမ်းနာမည် / အပိုင်း ရိုက်ထည့်ပါ..."
                    android:padding="8dp"
                    android:textColor="@color/z_text"
                    android:textColorHint="@color/z_muted"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbShowTitleOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="ခေါင်းစဉ် အမြဲပြသမည်"
                    android:textColor="@color/z_text" />
            </LinearLayout>

            <!-- 4. BLUR PANEL -->
            <LinearLayout
                android:id="@+id/panelBlur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swBlurEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="မျက်နှာ မှုန်ဝါးခြင်း (Face Blur Box)"
                    android:textColor="@color/z_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="နေရာ အနေအထား ပြောင်းရန် (Position Nudges):"
                    android:textColor="@color/z_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBlurLeft"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="⬅ ဘယ်"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnBlurRight"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="ညာ ➡"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnBlurUp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="⬆ အပေါ်"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnBlurDown"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="အောက် ⬇"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. LOGO PANEL -->
            <LinearLayout
                android:id="@+id/panelLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swLogoEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="လိုဂို / ရေစာ (Logo Watermark)"
                    android:textColor="@color/z_text" />

                <Button
                    android:id="@+id/btnPickLogo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:text="+ Gallery မှ Logo ပုံ ရွေးမည်"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ထောင့်နေရာ ချထားမှု (Position):"
                    android:textColor="@color/z_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPosTopLeft"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="TL"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPosTopRight"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="TR"
                        android:textColor="@color/z_orange"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPosBottomLeft"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="BL"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPosBottomRight"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="BR"
                        android:textColor="@color/z_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6. AUDIO PANEL -->
            <LinearLayout
                android:id="@+id/panelAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swMuteOriginalAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="မူရင်းဒရာမာအသံ ပိတ်မည် (Mute Original)"
                    android:textColor="@color/z_text" />

                <Button
                    android:id="@+id/btnPickBgm"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:text="+ Gallery / Storage မှ နောက်ခံသီချင်း (BGM) ရွေးမည်"
                    android:textColor="@color/z_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvBgmStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="BGM: ရွေးချယ်မထားပါ"
                    android:textColor="@color/z_muted"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- EXPORT PROGRESS / STATUS FOOTER -->
    <LinearLayout
        android:id="@+id/layoutRenderProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C20"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRenderStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Render Progress: 0%"
                android:textColor="@color/z_orange"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelRender"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Cancel"
                android:textColor="#EF4444"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbRenderProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/z_orange" />
    </LinearLayout>

</LinearLayout>
